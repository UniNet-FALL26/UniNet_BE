# PLACEHOLDERS ONLY. Supply secrets through the deployment secret manager.
GitHubApp__ValidateDeployment=true
GitHubApp__Enabled=false
GitHubApp__QueueHealth__WarningMinutes=15
GitHubApp__QueueHealth__CriticalMinutes=60
GitHubApp__AppId=<numeric-app-id>
GitHubApp__ClientId=<app-client-id>
GitHubApp__ClientSecret=<secret-reference>
GitHubApp__PrivateKeyPem=<secret-reference>
GitHubApp__WebhookSecret=<secret-reference>
GitHubApp__CallbackUrl=https://<api-host>/api/github/app/authorization/callback
GitHubApp__ReturnTargets__web=https://<frontend-host>/github/complete
GitHub__ClientId=<oauth-client-id>
GitHub__ClientSecret=<secret-reference>
GitHub__CallbackUrl=https://<api-host>/api/github/oauth/callback
GitHub__KeyRingPath=<absolute-shared-directory>
GitHub__KeyRingCertificatePath=<mounted-pfx-path>
GitHub__KeyRingCertificatePassword=<secret-reference-if-needed>
# During certificate rollover, retain every previous PFX still protecting ring keys.
GitHub__KeyRingPreviousCertificates__0__Path=<previous-mounted-pfx-path>
GitHub__KeyRingPreviousCertificates__0__Password=<secret-reference-if-needed>
