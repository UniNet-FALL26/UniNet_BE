# UniNet Backend configuration reference. NO REAL CREDENTIALS.
# Copy only into an ignored local .env; populate required values through a protected store.
# The custom parser supports one KEY=value per physical line, comments on separate lines,
# optional export, and matching outer quotes. It does NOT expand variables or decode \n.
# Never paste a multiline PEM into this file. Use a secure multiline process variable or
# GitHubApp__PrivateKeyPath pointing to an existing protected PEM file outside the repository.
# Nested ASP.NET configuration uses __; arrays use numeric indices; dictionaries use named keys.
# Empty required startup values below deliberately fail closed. No credentials are fabricated.

# 01 ASP.NET runtime
# Host environment is selected BEFORE the custom .env loader executes. Set it in the shell,
# IDE/launch profile or hosting platform, not merely as a line in this file.
# Example local command (choose a free port, do not replace an existing E2E process):
# $env:ASPNETCORE_ENVIRONMENT='Development'
# dotnet run --project UniNet.API/UniNet.API.csproj --no-launch-profile -- --urls http://127.0.0.1:5240
# Hosted runtime: publish first; set ASPNETCORE_ENVIRONMENT=Production and ASPNETCORE_URLS externally.
# If the platform supplies PORT, map it to --urls/ASPNETCORE_URLS in its start command;
# the Backend does not independently read a generic PORT configuration key.
# ASPNETCORE_URLS, ASPNETCORE_CONTENTROOT, DOTNET_ENVIRONMENT and UNINET_SKIP_LOCAL_ENV_FILE
# are process/host settings, not late-loaded dotenv switches.
# UNINET_SKIP_LOCAL_ENV_FILE=true prevents file loading; supply ALL required process config then.
# Master gate for DB/external-writing hosted workers. Default in code=true for backward compatibility.
# Keep false on a shared database until the deployment's worker ownership is explicitly verified.
# Account-session revocation supervision remains enabled outside existing E2E isolation.
BackgroundWorkers__Enabled=false
# AllowedHosts=* is the current JSON default; narrow host policy on the hosted deployment if required.
# AllowedHosts=
# Logging__LogLevel__Default=Information
# Logging__LogLevel__Microsoft.AspNetCore=Warning

# 02 Database — REQUIRED FOR STARTUP; use the single key actually read by Program.cs.
# Supply the approved target, user and secret. Do not copy an E2E connection into real runtime.
# Neon format: Host=<approved-neon-host>;Port=5432;Database=<database>;Username=<role>;Password=<secret>;SSL Mode=VerifyFull
# The runtime does NOT apply migrations. Design-time EF tooling can read the same root file;
# never run database update against an implicit target.
ConnectionStrings__UniNet=

# 03 JWT — REQUIRED. Preserve the current signing key; >=32 UTF-8 bytes.
Jwt__Key=
# Issuer/audience/access lifetime already have JSON defaults; override only intentionally.
# Jwt__Issuer=
# Jwt__Audience=
# Jwt__AccessMinutes=30
# Optional Google sign-in; approved Google OAuth client IDs, not GitHub credentials.
# Google__ClientIds__0=

# 04 Frontend / CORS
# Array indices MERGE with appsettings/Development arrays; they do not replace the whole array.
# Source also adds fixed non-E2E frontend origins. Review effective policy before public hosting.
# Preserve approved existing origins; this task does not widen CORS.
# Cors__Origins__0=

# 05 GitHub OAuth — feature requires real credentials, callback and named return targets.
GitHub__ClientId=
GitHub__ClientSecret=
# Registered callback must end in /api/github/oauth/callback (HTTPS; loopback HTTP development only).
GitHub__CallbackUrl=
# Map a request's returnTarget name to an approved frontend URL. No arbitrary client redirect.
# GitHub__ReturnTargets__web=
# GitHub__MobileRedirectSchemes__0=exp
# Existing code defaults, not a new scope policy:
# GitHub__Scopes__0=repo
# GitHub__Scopes__1=offline_access
# GitHub__AuthorizationEndpoint=https://github.com/login/oauth/authorize
# GitHub__TokenEndpoint=https://github.com/login/oauth/access_token
# GitHub__ApiBaseUrl=https://api.github.com/
# GitHub__FlowLifetimeMinutes=10
# Persistent private storage shared with the deployment that encrypted existing Git credentials.
# E2E key-ring reuse requires verified compatibility and explicit shared-environment approval.
# Do not generate a replacement for an existing deployment or infer approval from a matching path.
GitHub__KeyRingPath=
# App deployment validation additionally requires a current RSA certificate/private key.
GitHub__KeyRingCertificatePath=
GitHub__KeyRingCertificatePassword=
# Previous certificates are optional for rotation; preserve decryptability of existing tokens.
# GitHub__KeyRingPreviousCertificates__0__Path=
# GitHub__KeyRingPreviousCertificates__0__Password=

# 06 GitHub App — keep disabled until all credentials/public endpoints/key protection are verified.
GitHubApp__Enabled=false
GitHubApp__ValidateDeployment=false
# GitHubApp__AppId=
GitHubApp__ClientId=
GitHubApp__ClientSecret=
# Registered callback ends in /api/github/app/authorization/callback; App validation requires HTTPS.
GitHubApp__CallbackUrl=
# GitHubApp__ReturnTargets__web=
# GitHubApp__FlowLifetimeMinutes=10
# GitHubApp__PrivateKeyPem is CONSUMED as PEM CONTENT, not a filename or escaped \n string.
# Inject the entire real PEM as a multiline process/secret-provider environment variable:
# GitHubApp__PrivateKeyPem=<secure multiline environment value; DO NOT add this placeholder>
# Alternatively use an existing protected PEM file. Relative paths resolve against API content root.
# Explicit PrivateKeyPem wins over PrivateKeyPath; file contents are parsed, never written to .env.
# GitHubApp__PrivateKeyPath=
# No global InstallationId ENV exists: installations, grants and repository selection are DB state.

# 07 Webhooks — distinct secrets and routes; public URL is configured on GitHub, not an invented ENV.
# OAuth/manual webhook: POST /api/webhooks/github
GitHubWebhook__Secret=
GitHubWebhook__MaximumPayloadBytes=1048576
# GitHub App webhook: POST /api/webhooks/github/app
GitHubApp__WebhookSecret=
GitHubApp__MaximumWebhookPayloadBytes=1048576
# Do not register webhooks or consume deliveries just to validate configuration.

# 08 Git Sync — registration gate above AND these feature flags must permit execution.
GitHubSync__Enabled=false
GitHubSync__ManualEnqueueEnabled=false
GitHubSync__ScopedManual__Enabled=false
# Scoped mode requires approved IDs and global Enabled=false. Never use placeholder GUIDs.
# Missing JobId means enqueue-only, not permission to claim arbitrary jobs.
# GitHubSync__ScopedManual__ProjectId=
# GitHubSync__ScopedManual__AssociationId=
# GitHubSync__ScopedManual__JobId=
# GitHubSync__ScopedManual__ExecutionTimeoutSeconds=900
# Source defaults below; change only with operational justification.
# GitHubSync__DefaultIntervalHours=6
# GitHubSync__WorkerConcurrency=2
# GitHubSync__BatchSize=100
# GitHubSync__RetryBaseDelaySeconds=30
# GitHubSync__MaxRetryAttempts=8
# GitHubSync__JobLeaseDurationSeconds=300
# GitHubSync__PollSeconds=10
# GitHubSync__ReconciliationBatchSize=25
# GitHubSync__ReconciliationIntervalMinutes=15
# GitHubSync__ReconciliationTimeoutSeconds=30
# GitHubSync__ReconciliationPollSeconds=60
# GitHubSync__WebhookLeaseSeconds=120
# GitHubSync__WebhookMaxAttempts=8
# GitHubApp__QueueHealth__WarningMinutes=15
# GitHubApp__QueueHealth__CriticalMinutes=60
# E2E-ONLY: GitHubE2E__DisableUnrelatedWorkers=true (effective only in the E2E host environment).
# Do not use E2E scripts/watchdog as a generic Neon launcher.

# 09 Official Contribution V2
# No ENV scoring weights or readiness bypass. Policies remain 35/30/20/15 Git categories,
# separate GitShare/PeerShare normalization with 60/40 combination and approved applicability rules.
# Snapshot, peer closure, workflow mode, review/finalization/publication are persisted service state.

# 10 Storage — real credentials required only for Cloudinary-dependent features.
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
# Optional upload size override; current JSON/source contract enforces limits.
# Uploads__MaxVideoBytes=52428800
# Local profile files use content-root App_Data/profile-images; there is no custom ENV storage path.
# Portrait__LocalFallbackEnabled=true

# 11 Payments — do not mix merchants or replace existing credentials.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
# Existing aliases are supported: PAYOS_CLIENT_ID / PAYOS_API_KEY / PAYOS_CHECKSUM_KEY.
# Canonical PayOS keys win even if blank: use one naming style, not empty shadowing aliases.
Payments__ReturnUrl=
Payments__CancelUrl=
# Payments__LinkExpirationMinutes=30
# Payments__AllowUserReconciliation=true

# 12 Email / Notifications / Assessor
AssessorOnboarding__Enabled=false
# These are conditional requirements when assessor onboarding is enabled:
# AssessorOnboarding__PublicBaseUrl=
# AssessorOnboarding__StoragePath=
# Leave TemplatePath empty to use the bundled Vietnamese agreement.
# AssessorOnboarding__TemplatePath=
# AssessorOnboarding__CompanyName=
# AssessorOnboarding__CompanyTaxCode=
# AssessorOnboarding__CompanyAddress=
# AssessorOnboarding__RepresentativeName=
# AssessorOnboarding__RepresentativePosition=
# AssessorOnboarding__CompanyEmail=
# AssessorOnboarding__CompanyPhone=
# AssessorOnboarding__MinimumWithdrawalAmount=
# AssessorOnboarding__PaymentProcessingDays=
# AssessorOnboarding__TemplateVersion=
# AssessorOnboarding__FontPath=
# AssessorOnboarding__SignatureStatement=
# AssessorOnboarding__KeyRingPath=
# AssessorOnboarding__Smtp__Host=
# AssessorOnboarding__Smtp__Port=587
# AssessorOnboarding__Smtp__From=
# AssessorOnboarding__Smtp__Username=
# AssessorOnboarding__Smtp__Password=
# AssessorOnboarding__Smtp__PickupDirectory=  (Development only; absolute protected path)
# Notification/cleanup/portrait workers share BackgroundWorkers__Enabled.
# Re-enabling it enables those loops; there is no cross-instance leader lock for every loop.

# 13 Meetings / LiveKit — feature-specific, no token issuance during setup.
LiveKit__Url=
LiveKit__ApiKey=
LiveKit__ApiSecret=
# Legacy LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET aliases take precedence over section keys.
# URL must be wss:// origin (ws:// loopback only); LiveKit secret >=32 UTF-8 bytes.
# Jitsi__BaseUrl=https://meet.jit.si

# 14 Other integrations and approved policy
Gemini__ApiKey=
# Gemini__Model=gemini-3.1-flash-lite
# Gemini__PortraitModel=gemini-3.8-flash
# Model names above describe current source defaults, not a live provider-availability assertion.
VerificationWorker__Enabled=false
# VerificationWorker__PollSeconds=60
# Existing approved scheduling policy lives in appsettings; do not invent new policy values.
# ProjectVerification__ReservationMinutes=
# ProjectVerification__TimeZoneId=
# ProjectVerification__WorkingDays__0=
# ProjectVerification__WorkdayStart=
# ProjectVerification__WorkdayEnd=
# ProjectVerification__SlotMinutes=
# ProjectVerification__Capacity=
# ProjectVerification__MinimumNoticeMinutes=
# ProjectVerification__MaxAdvanceDays=
# ProjectModeration__AutoApproveConfidence=
# Projects__MaxOngoingProjectsPerStudent=3
