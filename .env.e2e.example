# Local Phase 3 E2E only. Fill placeholders in the ignored .env.e2e copy.
ASPNETCORE_ENVIRONMENT=E2E
ASPNETCORE_URLS=http://localhost:5239
UNINET_SKIP_LOCAL_ENV_FILE=true

# Must remain pinned to this disposable local PostgreSQL target.
ConnectionStrings__UniNet=Host=127.0.0.1;Port=55432;Database=uninet_e2e;Username=uninet_test;Password=__FILL_ME__;SSL Mode=Disable;

# Generate a random signing key of at least 32 UTF-8 bytes.
Jwt__Key=__FILL_ME_WITH_RANDOM_32_BYTES_MINIMUM__
Jwt__Issuer=https://uninet-e2e.local
Jwt__Audience=uninet-e2e-local
Jwt__AccessMinutes=30

# GitHub OAuth App callback must match this exact local callback URL.
GitHub__ClientId=__FILL_ME__
GitHub__ClientSecret=__FILL_ME__
GitHub__CallbackUrl=http://localhost:5239/api/github/oauth/callback
GitHub__KeyRingPath=.phase3-e2e-data-protection
GitHub__ReturnTargets__phase3-e2e=http://localhost:5239/swagger/index.html
GitHub__Scopes__0=repo
GitHub__Scopes__1=offline_access

# Copy the same random secret into GitHub Repository Settings > Webhooks.
GitHubWebhook__Secret=__FILL_ME_WITH_RANDOM_WEBHOOK_SECRET__
GitHubWebhook__MaximumPayloadBytes=1048576
GitHubE2E__WebhookPublicUrl=https://__FILL_ME_NGROK_HOST__/api/webhooks/github

# Worker settings. Sync is enabled only after the checker validates local config.
GitHubSync__Enabled=true
GitHubSync__DefaultIntervalHours=6
GitHubSync__WorkerConcurrency=1
GitHubSync__BatchSize=100
GitHubSync__RetryBaseDelaySeconds=30
GitHubSync__MaxRetryAttempts=8
GitHubSync__JobLeaseDurationSeconds=300
GitHubSync__PollSeconds=5

# Prevent unrelated local test data cleanup, payment/verification work, broadcasts,
# and Cloudinary portrait cleanup from running in the isolated E2E process.
GitHubE2E__DisableUnrelatedWorkers=true
VerificationWorker__Enabled=false

# Local browser/mobile test origin.
Cors__Origins__0=http://localhost:8081
