# Copy to .env.github-app.e2e (Git ignored). Never commit filled values.
ASPNETCORE_ENVIRONMENT=E2E
ASPNETCORE_URLS=http://localhost:5239
UNINET_SKIP_LOCAL_ENV_FILE=true
ConnectionStrings__UniNet=Host=127.0.0.1;Port=55432;Database=uninet_github_app_e2e;Username=postgres;Password=__FILL_ME__;SSL Mode=Disable;
Jwt__Key=__FILL_ME_WITH_RANDOM_32_BYTES_MINIMUM__
Jwt__Issuer=https://uninet-e2e.local
Jwt__Audience=uninet-e2e-local
GitHub__ClientId=__FILL_ME__
GitHub__ClientSecret=__FILL_ME__
GitHub__CallbackUrl=https://__FILL_ME_NGROK_HOST__/api/github/oauth/callback
GitHub__ReturnTargets__e2e=https://__FILL_ME_NGROK_HOST__/swagger/index.html
GitHub__KeyRingPath=__FILL_ME_ABSOLUTE_EXISTING_PRIVATE_DIRECTORY__
GitHub__KeyRingCertificatePath=__FILL_ME_ABSOLUTE_PFX_PATH__
GitHub__KeyRingCertificatePassword=__FILL_ME__
GitHub__Scopes__0=repo
GitHub__Scopes__1=offline_access
GitHubWebhook__Secret=__FILL_ME_SEPARATE_LEGACY_SECRET__
GitHubApp__Enabled=true
GitHubApp__AppId=__FILL_ME_NUMERIC_APP_ID__
GitHubApp__ClientId=__FILL_ME__
GitHubApp__ClientSecret=__FILL_ME__
# The launcher reads the PEM locally into GitHubApp__PrivateKeyPem in the child environment.
GitHubAppE2E__PrivateKeyPath=__FILL_ME_ABSOLUTE_PEM_PATH_OUTSIDE_REPOSITORY__
GitHubApp__WebhookSecret=__FILL_ME_APP_WEBHOOK_SECRET__
GitHubApp__CallbackUrl=https://__FILL_ME_NGROK_HOST__/api/github/app/authorization/callback
GitHubApp__ReturnTargets__e2e=https://__FILL_ME_NGROK_HOST__/swagger/index.html
GitHubAppE2E__WebhookPublicUrl=https://__FILL_ME_NGROK_HOST__/api/webhooks/github/app
GitHubSync__Enabled=true
GitHubE2E__DisableUnrelatedWorkers=true
VerificationWorker__Enabled=false
Cors__Origins__0=http://localhost:8081
